---
import BaseLayout from '../layouts/BaseLayout.astro';
import DastgahExplorer from '../components/DastgahExplorer';
---
<BaseLayout title="Home">
  <section class="max-w-3xl">
    <p class="text-xs uppercase tracking-widest text-amber-300 font-semibold mb-2">
      Computational Musicology & MIR
    </p>
    <h1 class="text-4xl font-bold tracking-tight text-white mb-4">
      Open Persian Music Hub
    </h1>
    <p class="text-slate-300 text-base leading-relaxed">
      An open-source research and reference platform covering Persian music history, modal theory (<em>Radif</em>),
      organology and acoustics, regional traditions, and computational Music Information Retrieval (MIR).
    </p>
  </section>

  <DastgahExplorer client:load />
</BaseLayout>
