---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="border-b border-slate-800 bg-slate-900/90 sticky top-0 z-20 backdrop-blur">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <a href={`${base}/`} class="text-lg font-bold tracking-tight text-teal-300">
      Open Persian MIR
    </a>
    <nav class="flex items-center gap-6 text-sm text-slate-300">
      <a href={`${base}/`} class="hover:text-amber-300 transition">Home</a>
      <a href={`${base}/theory/tuning-microtonality`} class="hover:text-amber-300 transition">Theory</a>
      <a href={`${base}/resources`} class="hover:text-amber-300 transition">Resources</a>
    </nav>
  </div>
</header>
